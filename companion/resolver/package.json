{
  "name": "kraken-hub-resolver",
  "version": "1.0.0",
  "description": "The optional kraken-hub companion: turns a page URL into a plain video file on 127.0.0.1, so the app can download it into its own clip library. Speaks the frozen v1 resolver protocol.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubberkid/kraken-hub.git",
    "directory": "companion/resolver"
  },
  "keywords": [
    "kraken-hub",
    "nzxt",
    "yt-dlp",
    "resolver"
  ],
  "bin": {
    "kraken-hub-resolver": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./contract": "./dist/contract.js"
  },
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node dist/cli.js",
    "test:live": "KRAKEN_HUB_LIVE=1 vitest run --config vitest.live.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
