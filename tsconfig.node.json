{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /*
     * `vite/client` alongside `node`, because a test may import app source.
     *
     * This project covers the tooling and the test files, and a Playwright spec
     * that imports a contract from `src/` — the sensible way to keep a spec and
     * the code it asserts on in step — drags that module's whole import graph in
     * with it. Some of that graph reads `import.meta.env`, which is Vite's
     * ambient declaration and was only in the app project's `types`, so the spec
     * typechecked against an `ImportMeta` that has no `env` and failed on a file
     * it never touched. Purely additive: it declares things, it removes nothing.
     */
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "src/types/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.mjs",
    "tests/**/*.ts"
  ]
}
