#!/bin/sh
# kraken-hub pre-commit hook.
#
# This hook is OPT-IN. Nothing installs it automatically (no husky, no
# `prepare` script), so `npm ci` never rewrites your git config. Enable it with:
#
#     npm run hooks:install     # git config core.hooksPath .githooks
#
# Disable it again with: git config --unset core.hooksPath
#
# CI is the enforcement point; this is only a convenience.
exec npx --no-install lint-staged
